LEAD_INTELLIGENCE_RUNNER_URL=
LEAD_INTELLIGENCE_RUNNER_TOKEN=
LEAD_INTELLIGENCE_REVIEW_URL=
CREDENTIAL_BROKER_URL=
CREDENTIAL_BROKER_TOKEN=
# Tests and explicit non-production local previews only. This keeps credentials
# in memory and performs no Google request. Never enable it in production.
NEGRONI_LOCAL_FAKE_SECRET_BROKER=
# Optional installed-edition overrides
NEGRONI_BROKER_PORT=47831
NEGRONI_RUNNER_PORT=47832
# Required with the broker token above; both must be distinct 32-512 character
# server secrets for `serve:private`.
NEGRONI_RUNNER_TOKEN=
# Optional private/durable root overrides for the runner service.
NEGRONI_RUNTIME_ROOT=
NEGRONI_ARTIFACT_ROOT=
# The local launcher enables the reviewed embedded prompt bundle. Hosted
# runners must deliberately configure an equivalent validated prompt source.
NEGRONI_PROMPT_SOURCE_MODE=
# Optional scoped 1Password Developer Environment injections.
NEGRONI_GEMINI_API_KEY=
NEGRONI_KIE_API_KEY=
NEGRONI_APIFY_API_TOKEN=
