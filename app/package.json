{
  "name": "@negroni/local",
  "version": "0.9.0-beta.1",
  "private": false,
  "license": "MIT",
  "bin": {
    "negroni": "bin/negroni.mjs"
  },
  "files": [
    "app",
    "bin/competitor-research-engine.py",
    "bin/competitor-research.ts",
    "bin/draper.ts",
    "bin/negroni-mcp.mjs",
    "bin/negroni.mjs",
    "bin/research-runner.ts",
    "build",
    "components",
    "db",
    "drizzle",
    "fixtures",
    "lib",
    "migrations",
    "public",
    "scripts/local-broker.mjs",
    "scripts/local-doctor.mjs",
    ".openai/hosting.json",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "vite.config.ts",
    "worker"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:local": "node bin/negroni.mjs start",
    "runner:local": "node --experimental-strip-types bin/research-runner.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib tests scripts worker vite.config.ts next.config.ts eslint.config.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "validate": "npm run check && npm run build"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@tailwindcss/postcss": "4.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "playwright-core": "1.62.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module"
}
